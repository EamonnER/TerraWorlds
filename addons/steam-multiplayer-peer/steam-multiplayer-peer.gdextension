[configuration]
entry_symbol = "steam_multiplayer_peer_init"
compatibility_minimum = "4.7"

[libraries]
windows.release.x86_64 = "./windows/steam-multiplayer-peer.windows.template_release.x86_64.dll"
windows.debug.x86_64 = "./windows/steam-multiplayer-peer.windows.template_debug.x86_64.dll"
windows.release.double.x86_64 = "./windows/steam-multiplayer-peer.windows.template_release.double.x86_64.dll"
windows.debug.double.x86_64 = "./windows/steam-multiplayer-peer.windows.template_debug.double.x86_64.dll"

linux.release.x86_64 = "./linux/libsteam-multiplayer-peer.linux.template_release.x86_64.so"
linux.debug.x86_64 = "./linux/libsteam-multiplayer-peer.linux.template_debug.x86_64.so"
linux.release.double.x86_64 = "./linux/libsteam-multiplayer-peer.linux.template_release.double.x86_64.so"
linux.debug.double.x86_64 = "./linux/libsteam-multiplayer-peer.linux.template_debug.double.x86_64.so"

linux.release.arm64 = "./linux/libsteam-multiplayer-peer.linux.template_release.arm64.so"
linux.debug.arm64 = "./linux/libsteam-multiplayer-peer.linux.template_debug.arm64.so"
linux.release.double.arm64 = "./linux/libsteam-multiplayer-peer.linux.template_release.double.arm64.so"
linux.debug.double.arm64 = "./linux/libsteam-multiplayer-peer.linux.template_debug.double.arm64.so"

macos.debug.x86_64 = "./macos/libsteam-multiplayer-peer.macos.template_debug.x86_64.dylib"
macos.debug.double.x86_64 = "./macos/libsteam-multiplayer-peer.macos.template_debug.double.x86_64.dylib"
macos.release.x86_64 = "./macos/libsteam-multiplayer-peer.macos.template_release.x86_64.dylib"
macos.release.double.x86_64 = "./macos/libsteam-multiplayer-peer.macos.template_release.double.x86_64.dylib"

macos.debug.arm64 = "./macos/libsteam-multiplayer-peer.macos.template_debug.arm64.dylib"
macos.debug.double.arm64 = "./macos/libsteam-multiplayer-peer.macos.template_debug.double.arm64.dylib"
macos.release.arm64 = "./macos/libsteam-multiplayer-peer.macos.template_release.arm64.dylib"
macos.release.double.arm64 = "./macos/libsteam-multiplayer-peer.macos.template_release.double.arm64.dylib"
