; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="TerraWorlds"
run/main_scene="uid://5fuyxnhgd51k"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GlobalVariables="*res://src/global_variables.gd"
MultiplayerManager="*res://src/multiplayer/multiplayer_manager.gd"
ItemOracle="*res://src/item/item_oracle.gd"
RpcInterface="*res://src/multiplayer/rpc_interface.gd"

[debug]

gdscript/warnings/standalone_ternary=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1080
window/size/viewport_height=720
mouse_cursor/custom_image="res://assets/crosshair.png"
mouse_cursor/custom_image_hotspot=Vector2(8, 8)

[dotnet]

project/assembly_name="TerraWorlds"

[editor_plugins]

enabled=PackedStringArray()

[importer_defaults]

animation_library={
"animation/fps": 60.0
}

